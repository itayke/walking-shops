{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "walking-shops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The phone app at the root and the screen app under /screen, built by `npm run build:site`. The screen's paths
  // reach the Worker first, which asks for the presenter's password
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/screen", "/screen/*"]
  },
  "routes": [{ "pattern": "shopshuffle.untame.com", "custom_domain": true }],
  // Reachable from phones on the LAN in dev; the port matches DEV_PORTS.server in packages/net/src/config.ts
  "dev": { "ip": "0.0.0.0", "port": 7322 }
}
