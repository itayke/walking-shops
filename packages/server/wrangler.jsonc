{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "walking-shops",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Reachable from phones on the LAN in dev; the port matches DEV_PORTS.server in packages/net/src/config.ts
  "dev": { "ip": "0.0.0.0", "port": 7322 }
}
