{
  "name": "walking-shops",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces --if-present",
    "bench": "node packages/sim/bench/bench.ts",
    "bench:compare": "node packages/sim/bench/bench.ts --compare",
    "dev:screen": "npm run dev -w @walking-shops/screen",
    "dev:phone": "npm run dev -w @walking-shops/phone",
    "dev:server": "npm run dev -w @walking-shops/server",
    "loadtest": "npm run loadtest -w @walking-shops/net --",
    "bots": "npm run bots -w @walking-shops/net --",
    "build:site": "npm run build:site -w @walking-shops/phone && npm run build:site -w @walking-shops/screen",
    "deploy": "npm run typecheck && npm run build:site && npm run deploy -w @walking-shops/server",
    "dev": "concurrently -k -n server,screen,phone -c magenta,cyan,yellow \"npm:dev:server\" \"npm:dev:screen\" \"npm:dev:phone\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
